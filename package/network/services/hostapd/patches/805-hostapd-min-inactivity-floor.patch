+	if (sta->max_idle_period) {
+		/*
+		 * Never disconnect a station sooner than the AP-wide
+		 * ap_max_inactivity: some clients (e.g. Apple) advertise a
+		 * short BSS Max Idle Period for power saving and expect
+		 * buffered keep-alives, not disassociation. Adopting the
+		 * value as-is made idle stations get kicked ~20s after
+		 * association when the data poll went unanswered
+		 * (XR1710G MLO, 2026-09-26).
+		 */
+		int adopted = (sta->max_idle_period * 1024 + 999) / 1000;
+
+		if (adopted < max_inactivity)
+			adopted = max_inactivity;
+		max_inactivity = adopted;
+	}
 
