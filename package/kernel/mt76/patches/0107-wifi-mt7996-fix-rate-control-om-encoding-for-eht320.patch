From: XR1710G Community
Subject: wifi: mt7996: fix rate control operating-mode encoding for EHT 320 MHz

VHT operating-mode fields have no encoding above 160 MHz; writing
IEEE80211_STA_RX_BW_320 (=4) hands the firmware an out-of-range
width whenever OMI makes the capability differ from the operating
bandwidth. Signal OM only on NSS mismatch and clamp the width to
the VHT-expressable range; EHT320 bandwidth stays expressed via
CMD_CBW_320MHZ in ra->bw / ra->phy.bw.
---
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -2790,11 +2790,22 @@
 		     CMD_CBW_320MHZ : cap_bw;
 	ra->mmps_mode = mt7996_mcu_get_mmps_mode(link_sta->smps_mode);
 
-	ra->op_mode = cap_bw != link_sta->bandwidth ||
-		      cap_nss != link_sta->rx_nss;
-	ra->op_vht_chan_width = link_sta->bandwidth;
-	ra->op_vht_rx_nss = link_sta->rx_nss ? link_sta->rx_nss - 1 : 0;
+	/* VHT operating-mode fields have no encoding for 320 MHz (valid
+	 * range 0..3); writing IEEE80211_STA_RX_BW_320 (=4) hands the
+	 * firmware an out-of-range width. Only signal OM when the NSS
+	 * differs, clamp the width field to the VHT-expressable range, and
+	 * keep the real bandwidth in ra->bw / ra->phy.bw (CMD_CBW_320MHZ).
+	 */
+	ra->op_mode = cap_nss != link_sta->rx_nss;
+	ra->op_vht_chan_width = 0;
+	ra->op_vht_rx_nss = 0;
 	ra->op_vht_rx_nss_type = 0;
+	if (ra->op_mode) {
+		ra->op_vht_chan_width =
+			link_sta->bandwidth >= IEEE80211_STA_RX_BW_160 ? 3 :
+			link_sta->bandwidth;
+		ra->op_vht_rx_nss = link_sta->rx_nss ? link_sta->rx_nss - 1 : 0;
+	}
 
 	if (supp_rate) {
 		supp_rate &= mask->control[band].legacy;
