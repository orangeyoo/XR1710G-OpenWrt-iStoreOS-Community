+		 * loop starves the operating link's key installation - the
+		 * client then cannot complete its handshake on the band it is
+		 * actually associated to.  Restrict the operation to the link
+		 * the STA really uses.
+		 */
+		struct mt7996_sta *msta = (struct mt7996_sta *)sta->drv_priv;
+
+		if (msta->deflink_id != IEEE80211_LINK_UNSPECIFIED)
+			links = BIT(msta->deflink_id);
+		else
+			links = BIT(0);
+	}
