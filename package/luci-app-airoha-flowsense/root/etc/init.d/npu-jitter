#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

DAEMON=/usr/libexec/npu-jitter-daemon
PIDFILE=/var/run/npu-jitter.pid

start_service() {
	local target
	target=$(uci -q get npu-monitor.jitter.target 2>/dev/null ||
		uci -q get 'npu-monitor.@jitter[0].target' 2>/dev/null ||
		echo "auto")
	if [ -z "$target" ] || [ "$target" = "auto" ]; then
		target=$(ubus call network.interface.wan status 2>/dev/null |
			jsonfilter -e '@["dns-server"][0]' 2>/dev/null)
		[ -n "$target" ] || target="1.1.1.1"
	fi

	procd_open_instance
	procd_set_param command "$DAEMON" "$target"
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn 30 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	rm -f /tmp/npu-jitter.json
}

reload_service() {
	stop
	start
}
