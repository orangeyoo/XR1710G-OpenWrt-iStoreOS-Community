Subject: [PATCH] net: airoha: buffer DSA hardware forwarding on affected boards

Keep PPE offload enabled and select DRAM hardware-forwarding descriptors
only for DSA destinations on boards opting into the workaround.
Direct GDM and WDMA paths and all boards without the property retain
their previous behavior. No runtime debug knob or live FOE writes.
---
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -456,10 +456,13 @@
 			val |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, pse_port) |
 			       FIELD_PREP(AIROHA_FOE_IB2_DSCP, dsfield) |
 			       AIROHA_FOE_IB2_PSE_QOS;
-			/* For downlink traffic consume SRAM memory for hw
-			 * forwarding descriptors queue.
+			/* Slow DSA egress can exhaust the SRAM descriptor queue
+			 * under bursts from a faster ingress. Use buffered DRAM
+			 * hardware forwarding on boards with this limitation.
+			 * Direct GDM and WDMA output paths are unchanged.
 			 */
-			if (airoha_is_lan_gdm_dev(dev))
+			if (airoha_is_lan_gdm_dev(dev) &&
+			    (dsa_port < 0 || !eth->dsa_dram_forwarding))
 				val |= AIROHA_FOE_IB2_FAST_PATH;
 			if (dsa_port >= 0)
 				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ,
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -681,6 +681,7 @@
 
 struct airoha_eth {
 	struct device *dev;
+	bool dsa_dram_forwarding;
 
 	const struct airoha_eth_soc_data *soc;
 
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4694,6 +4694,9 @@
 		return -EINVAL;
 
 	eth->dev = &pdev->dev;
+	eth->dsa_dram_forwarding =
+		of_property_read_bool(eth->dev->of_node,
+				      "airoha,dsa-dram-forwarding");
 
 	err = dma_set_mask_and_coherent(eth->dev, DMA_BIT_MASK(32));
 	if (err) {
