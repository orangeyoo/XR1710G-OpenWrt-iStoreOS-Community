+/* The CDM LRO configuration is QDMA-wide, so upstream ties NETIF_F_LRO to
+ * single-open ownership of the QDMA. On XR1710G eth0 (gdm1, switch CPU
+ * port) and lan1 (gdm4) share QDMA0, which keeps qdma->users > 1 and makes
+ * the ethtool path unusable there. force_lro bypasses the per-netdev
+ * feature negotiation and toggles the QDMA0 aggregate directly:
+ *   echo 1  > /sys/module/airoha_eth/parameters/force_lro  (enable QDMA0)
+ *   echo -1 > /sys/module/airoha_eth/parameters/force_lro  (disable)
+ */
+static int airoha_force_lro = -1;
+static int airoha_force_lro_applied = -1;
+static DEFINE_MUTEX(airoha_force_lro_mutex);
+static struct airoha_eth *airoha_force_lro_eth;
+
+static bool airoha_qdma_lro_forced(int qdma_id)
+{
+	return airoha_force_lro == qdma_id ||
+	       airoha_force_lro_applied == qdma_id;
+}
+
+static void airoha_force_lro_apply(struct airoha_eth *eth, int qdma_id,
+				   bool enable)
+{
+	if (enable)
+		airoha_qdma_lro_enable(&eth->qdma[qdma_id]);
+	else
+		airoha_fe_lro_disable(eth, qdma_id);
+
+	dev_info(eth->dev, "force %s HW LRO on QDMA%d\n",
+		 enable ? "enabled" : "disabled", qdma_id);
+}
+
+static int airoha_force_lro_set(const char *val,
+				const struct kernel_param *kp);
+static const struct kernel_param_ops airoha_force_lro_ops = {
+	.set = airoha_force_lro_set,
+	.get = param_get_int,
+};
+
+static int airoha_force_lro_set(const char *val,
+				const struct kernel_param *kp)
+{
+	struct airoha_eth *eth;
+	int ret;
+
+	ret = param_set_int(val, kp);
+	if (ret)
+		return ret;
+
+	if (airoha_force_lro >= AIROHA_MAX_NUM_QDMA)
+		return -EINVAL;
+
+	mutex_lock(&airoha_force_lro_mutex);
+	eth = airoha_force_lro_eth;
+	if (eth) {
+		if (airoha_force_lro_applied >= 0) {
+			airoha_force_lro_apply(eth, airoha_force_lro_applied,
+					       false);
+			airoha_force_lro_applied = -1;
+		}
+		if (airoha_force_lro >= 0) {
+			airoha_force_lro_apply(eth, airoha_force_lro, true);
+			airoha_force_lro_applied = airoha_force_lro;
+		}
+	}
+	mutex_unlock(&airoha_force_lro_mutex);
+
+	return 0;
+}
+module_param_call(force_lro, airoha_force_lro_set, param_get_int,
+		  &airoha_force_lro, 0644);
