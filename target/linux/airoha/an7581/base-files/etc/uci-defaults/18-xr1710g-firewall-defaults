#!/bin/sh

. /lib/functions/system.sh

[ "$(board_name)" = "econet,xr1710g-ubi" ] || exit 0

# 14-airoha-hw-flow-offload owns the initial 1/1 defaults. Do not undo
# them here, or override explicit choices restored by a keep-config upgrade.
# FullCone NAT stays enabled on IPv4 (v1.9 factory parity); fullcone6 stays off.
uci -q set firewall.@defaults[0].fullcone='1'
uci -q commit firewall

firewall_whiteout=/overlay/upper/etc/rc.d/S19firewall

# Older images disabled firewall by leaving an OverlayFS whiteout over the
# ROM startup link. Remove only that whiteout before enabling the service.
if [ -c "$firewall_whiteout" ]; then
	rm -f "$firewall_whiteout"
fi

if [ -x /etc/init.d/firewall ]; then
	/etc/init.d/firewall enable
	/etc/init.d/firewall restart
fi

exit 0
