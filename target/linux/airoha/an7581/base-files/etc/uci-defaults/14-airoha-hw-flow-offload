#!/bin/sh

# Enable routed/NAT hardware flow offload by default on AN7581 boards.
# fw4 needs both options for the PPE/NPU fastpath. Read the actual defaults
# section (which is normally anonymous), and preserve explicit owner choices.
uci -q get firewall.@defaults[0] >/dev/null || exit 1

[ -n "$(uci -q get firewall.@defaults[0].flow_offloading)" ] ||
    uci -q set firewall.@defaults[0].flow_offloading='1' || exit 1
[ -n "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" ] ||
    uci -q set firewall.@defaults[0].flow_offloading_hw='1' || exit 1

uci -q commit firewall || exit 1
exit 0
