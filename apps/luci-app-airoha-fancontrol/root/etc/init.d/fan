#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

disable_competing_controller() {
	# airoha_fan is retained as a board-support reference, but it must never
	# race this configurable controller for the same NCT7802 registers.
	if [ -x /etc/init.d/airoha_fan ]; then
		/etc/init.d/airoha_fan disable 2>/dev/null
	fi
}

start_service() {
	disable_competing_controller

	procd_open_instance
	# iStoreOS injects libsetlbf.so into procd services. On this target that
	# preload makes BusyBox shell writes to NCT7802 sysfs fail even as root,
	# while the same checked writes succeed without it.
	procd_set_param command /usr/bin/env -u LD_PRELOAD /usr/sbin/xr1710g-fan-control run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "fan"
}
