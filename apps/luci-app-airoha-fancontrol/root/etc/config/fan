config fancontrol 'settings'
	option mode 'auto'
	option manual_pwm '127'
	option curve_preset 'balanced'
	option poll_interval '5'
	option hysteresis '3'
	option minimum_pwm '54'
	option failsafe_temp '88'

config curve 'quiet'
	option point1_temp '65'
	option point1_pwm '54'
	option point2_temp '72'
	option point2_pwm '69'
	option point3_temp '80'
	option point3_pwm '95'
	option point4_temp '86'
	option point4_pwm '199'
	option point5_temp '90'
	option point5_pwm '255'

config curve 'balanced'
	# PWM 54 is the vendor-derived, known stable minimum. Temperatures below
	# point 2 remain at this first step, so a 59 C PHY does not demand 75%.
	option point1_temp '60'
	option point1_pwm '54'
	option point2_temp '68'
	option point2_pwm '69'
	option point3_temp '76'
	option point3_pwm '95'
	option point4_temp '83'
	option point4_pwm '199'
	option point5_temp '88'
	option point5_pwm '255'

config curve 'performance'
	option point1_temp '55'
	option point1_pwm '69'
	option point2_temp '63'
	option point2_pwm '95'
	option point3_temp '72'
	option point3_pwm '150'
	option point4_temp '80'
	option point4_pwm '199'
	option point5_temp '85'
	option point5_pwm '255'

config curve 'custom'
	option point1_temp '60'
	option point1_pwm '54'
	option point2_temp '68'
	option point2_pwm '69'
	option point3_temp '76'
	option point3_pwm '95'
	option point4_temp '83'
	option point4_pwm '199'
	option point5_temp '88'
	option point5_pwm '255'
