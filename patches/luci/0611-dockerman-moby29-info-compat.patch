+function scalarOrDash(value) {
+	if (value === undefined || value === null || value === '' ||
+	    typeof value === 'object')
+		return '-';
+
+	return String(value);
+}
+
+function formatMemory(value) {
+	const bytes = Number(value);
+
+	return Number.isFinite(bytes) && bytes > 0
+		? '%1024.2m'.format(bytes)
+		: '-';
+}
+
+function stringifyNestedDockerValue(value) {
+	try {
+		const json = JSON.stringify(value, null, 2);
+		return json === undefined ? String(value) : json;
+	}
+	catch (e) {
+		return String(value);
+	}
+}
+
+function renderNestedDockerInfo(info) {
+	const nested = Object.entries(info || {})
+		.filter(([, value]) => value !== null && typeof value === 'object')
+		.sort(([left], [right]) => left.localeCompare(right));
+
+	if (nested.length === 0)
+		return null;
+
+	return E('details', { 'class': 'cbi-section dockerman-advanced-info' }, [
+		E('summary', {}, [_('Advanced Docker information')]),
+		E('p', { 'class': 'cbi-map-descr' }, [
+			_('Nested Docker API values are collapsed by default and formatted for safe viewing.')
+		]),
+		...nested.map(([key, value]) => E('details', {
+			'class': 'dockerman-advanced-entry'
+		}, [
+			E('summary', {}, [key]),
+			E('pre', {
+				'style': 'white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; max-width: 100%; max-height: 32em; overflow: auto;'
+			}, [stringifyNestedDockerValue(value)])
+		]))
+	]);
+}
 
